{
  "name": "ai-api-demo",
  "private": true,
  "workspaces": [
    "apps/helper-services-assistant",
    "apps/mcp",
    "apps/webMCP"
  ],
  "scripts": {
    "preinstall": "node clean-app-deps.cjs",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "dependencies": {
    "@arcgis/ai-components": "5.1.27",
    "@arcgis/core": "5.1.27",
    "@arcgis/map-components": "5.1.27",
    "@esri/calcite-components": "5.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide": "0.468.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
